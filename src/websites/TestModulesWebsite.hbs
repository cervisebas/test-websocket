<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <title>WebSocket Tester</title>
  <meta name="color-scheme" content="dark" />

  <style>
    * {
      box-sizing: border-box;
      font-family: Arial;
    }

    body {
      margin: 40px;
      background: #181818;
      color: white;
    }

    .container {
      max-width: 900px;
      margin: auto;
    }

    input,
    textarea {

      width: 100%;
      padding: 10px;
      margin: 10px 0;
      border: none;
      border-radius: 6px;
    }

    textarea {
      height: 220px;
      resize: vertical;
      font-family: monospace;
    }

    button {
      padding: 10px 18px;
      cursor: pointer;
    }

    .connection {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .connection input {
      flex: 1;
    }

    .online {
      color: #00d000;
    }

    .offline {
      color: #ff4444;
    }

    pre {
      background: #252525;
      padding: 15px;
      height: 350px;
      overflow: auto;
      border-radius: 6px;
    }
  </style>
</head>

<body>

  <div class="container">

    <h1>WebSocket Tester</h1>

    <div class="connection">

      <input id="host" value="{{host}}" placeholder="ws://localhost:3000">

      <button id="connect">
        Conectar
      </button>

      <span id="status" class="offline">
        Desconectado
      </span>

    </div>

    <hr>

    <h2>Enviar Request</h2>

    <label>Path</label>

    <input id="path" value="/test/ping" placeholder="/test/ping">

    <label>JSON</label>

    <textarea id="payload">
{
    "test": "ping"
}
    </textarea>

    <button id="send">
      Enviar
    </button>

    <hr>

    <h2>Historial</h2>

    <pre id="history"></pre>

  </div>

  <script>
    let socket;

    const history = document.getElementById("history");
    const status = document.getElementById("status");

    function log(title, data) {
      history.textContent +=
        `[${new Date().toLocaleTimeString()}] ${title}\n` +
        `${JSON.stringify(data, null, 4)}\n\n`;

      history.scrollTop = history.scrollHeight;
    }

    document.getElementById("connect").onclick = () => {

      if (socket?.readyState === WebSocket.OPEN) {
        socket.close();
        return;
      }

      const host = document.getElementById("host").value;
      console.log('Connecting to:', host);
      socket = new WebSocket(host);

      socket.onopen = () => {
        status.innerText = "Conectado";
        status.className = "online";
        log("OPEN", {});
      };

      socket.onclose = () => {
        status.innerText = "Desconectado";
        status.className = "offline";
        log("CLOSE", {});
      };

      socket.onerror = (err) => {
        log("ERROR", err);
      };

      socket.onmessage = (event) => {

        let json;

        try {
          json = JSON.parse(event.data);
        } catch {
          json = event.data;
        }

        log("RESPONSE", json);
      };
    };

    document.getElementById("send").onclick = () => {

      if (!socket || socket.readyState !== WebSocket.OPEN) {
        return alert("No conectado");
      }

      let data = {};

      try {
        data = JSON.parse(
          document.getElementById("payload").value
        );
      } catch {
        return alert("JSON inválido");
      }

      const request = {
        data: {
          path: document.getElementById("path").value,
          data
        }
      };

      log("REQUEST", request);

      socket.send(JSON.stringify(request));
    };
  </script>

</body>

</html>